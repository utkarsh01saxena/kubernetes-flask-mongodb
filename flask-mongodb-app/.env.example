# Local unauthenticated setup (Part 1)
# MONGODB_URI=mongodb://localhost:27017/flask_db

# Local authenticated setup or Docker Compose
# MONGODB_URI=mongodb://admin:password123@localhost:27017/flask_db?authSource=admin

# Or using discrete variables (Part 2)
MONGO_USERNAME=admin
MONGO_PASSWORD=password123
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=flask_db
MONGO_AUTH_SOURCE=admin

FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

