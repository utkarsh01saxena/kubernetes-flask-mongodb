apiVersion: v1
kind: Secret
metadata:
  name: mongodb-secret
  namespace: flask-mongo-app
  labels:
    app.kubernetes.io/name: mongodb
    app.kubernetes.io/component: database
type: Opaque
# Generate base64 values: echo -n "your_value" | base64
# Example new strong password: "M0ngo_Secur3_2026!#pAss"
data:
  mongo-root-username: <BASE64_USERNAME>
  mongo-root-password: <BASE64_PASSWORD>
  mongo-db: <BASE64_DATABASE_NAME>
  mongo-uri: <BASE64_CONNECTION_URI>
